# Optional overrides for the launchers.
# Copy to .env and source it, or export these in your shell.

# Label used by the local PyTok account pool (not an email, not uploaded).
TIKTOK_ACCOUNT="$USER"

# Where Étoile writes JSON/CSV/XLSX files.
ETOILE_OUTPUT_DIR="$HOME/TikTokResearch/Étoile"

# Where Lumière writes MP4, storyboards and reports.
LUMIERE_OUTPUT_DIR="$HOME/TikTokResearch/Lumière_视频深析"

# Optional: point the launchers at a specific Python interpreter.
# ETOILE_PYTHON="$PWD/.venv/bin/python"
# LUMIERE_PYTHON="$PWD/.venv/bin/python"
